# AI Operations Copilot — environment template
# Copy to .env and fill in values. Never commit .env.

# Application
APP_NAME=AI Operations Copilot
APP_ENV=development
APP_MODE=local
# APP_MODE: local | test | foundry
# local  = product works without Foundry; AI actions report Foundry unavailable
# test   = deterministic fixtures for automated tests (never presented as Foundry)
# foundry = real Microsoft Foundry chat + embeddings
LOG_LEVEL=INFO
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173

# Database
# Local Docker / localhost (no TLS):
DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/ai_operations_copilot
DATABASE_URL_SYNC=postgresql+psycopg://copilot:copilot@localhost:5432/ai_operations_copilot
# Azure PostgreSQL Flexible Server requires TLS. The two drivers are not the same:
# asyncpg uses ssl=require. psycopg uses sslmode=require. Do not swap those query names.
# URL-encode any special characters in the password (@ : / ? # % &).
# DATABASE_URL=postgresql+asyncpg://copilotadmin:<YOUR_PRIVATE_PASSWORD>@adel-ai-operations-pg.postgres.database.azure.com:5432/ai_operations_copilot?ssl=require
# DATABASE_URL_SYNC=postgresql+psycopg://copilotadmin:<YOUR_PRIVATE_PASSWORD>@adel-ai-operations-pg.postgres.database.azure.com:5432/ai_operations_copilot?sslmode=require

# Microsoft Foundry — chat (project Responses API via FoundryChatClient)
# Authenticate with Microsoft Entra (Azure CLI locally, managed identity in Azure).
# Do not set API keys.
FOUNDRY_PROJECT_ENDPOINT=https://adel-ai-operations-foundry.services.ai.azure.com/api/projects/ai-operations-copilot
FOUNDRY_MODEL=gpt-5-mini

# Embeddings — Azure OpenAI v1 endpoint, NOT the Foundry project endpoint.
# FoundryEmbeddingClient is not used: it requires an API key. The app uses
# DefaultAzureCredential + OpenAI embeddings.create against this endpoint.
FOUNDRY_MODELS_ENDPOINT=https://adel-ai-operations-foundry.services.ai.azure.com/openai/v1
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small
FOUNDRY_EMBEDDING_DIMENSIONS=1536

# Retrieval
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.22
RETRIEVAL_RRF_K=60
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_RATIO=0.15

# Cost and abuse controls
MAX_TICKET_CHARS=8000
MAX_UPLOAD_BYTES=5242880
MAX_MODEL_OUTPUT_TOKENS=16384
AI_REQUEST_TIMEOUT_SECONDS=60
DAILY_DEMO_AI_RUN_LIMIT=40
DEMO_MAX_TICKETS=250
DEMO_GUEST_COOKIE_NAME=aoc_demo_guest

# Observability
OTEL_SERVICE_NAME=ai-operations-copilot
OTEL_EXPORTER_OTLP_ENDPOINT=
ENABLE_SENSITIVE_TELEMETRY=false
# Production Container Apps: secret-backed APPLICATIONINSIGHTS_CONNECTION_STRING.
# Do not commit the connection string. Local/test leave it empty.

# Demo
DEMO_PUBLIC=true
DEMO_DISABLE_FULL_EVAL=true
